{
  "name": "jwt-inspector",
  "version": "1.1.0",
  "description": "JWT inspection and pinned-algorithm cryptographic verification CLI",
  "license": "MIT",
  "author": "Felipe Watter",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jwt-inspector": "./dist/bin/index.js"
  },
  "main": "./dist/src/validator.js",
  "types": "./dist/src/validator.d.ts",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/bin/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~7.0.2"
  }
}
